{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aielia",
  "mainBinaryName": "aielia-desktop",
  "version": "0.1.3",
  "identifier": "com.buildaharness.assistant",
  "build": {
    "frontendDist": "../../chat-ui/dist",
    "devUrl": "http://localhost:3010",
    "beforeDevCommand": {
      "script": "npm run dev --workspace=packages/chat-ui",
      "cwd": "../../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build --workspace=packages/chat-ui",
      "cwd": "../../.."
    }
  },
  "app": {
    "windows": [
      {
        "title": "Aielia",
        "width": 1100,
        "height": 760,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:3010 http://localhost:3010; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
