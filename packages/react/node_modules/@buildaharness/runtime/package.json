{
  "name": "@buildaharness/runtime",
  "version": "0.2.0",
  "description": "Framework-agnostic client-side FlowSpec executor for Build A Harness — storage adapters (in-memory, IndexedDB/Dexie), experience store, and LLM clients (proxy, Anthropic, OpenAI-compatible).",
  "license": "Apache-2.0",
  "homepage": "https://buildaharness.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3IVIS/buildaharness.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "buildaharness",
    "agent-harness",
    "ai-agent",
    "llm",
    "flowspec",
    "indexeddb"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.config.lib.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buildaharness/harness": "^0.2.0",
    "dexie": "^4.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.4.5",
    "vite": "^5.3.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.6.0"
  }
}
