{
  "name": "@buildaharness/react",
  "version": "0.2.0",
  "description": "React bindings for Build A Harness — a useHarness() hook wrapping @buildaharness/runtime.",
  "license": "Apache-2.0",
  "homepage": "https://buildaharness.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3IVIS/buildaharness.git",
    "directory": "packages/react"
  },
  "keywords": [
    "buildaharness",
    "agent-harness",
    "ai-agent",
    "react",
    "hooks"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.lib.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buildaharness/runtime": "^0.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.4",
    "vitest": "^1.6.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
