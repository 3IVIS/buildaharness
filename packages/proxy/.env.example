# Copy to .env and fill in your values before running docker compose.
# Never commit .env to version control.

# ── Secrets ───────────────────────────────────────────────────────────────────
# For CF Worker, set these via: wrangler secret put <NAME>
# For Docker/Node.js, set them here (they stay server-side).

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PROXY_SECRET=change-me-to-a-random-string
# BRAVE_API_KEY — only needed if WEB_SEARCH_BACKEND=brave. Get one at
# https://api.search.brave.com/app/keys
BRAVE_API_KEY=

# ── Public configuration ──────────────────────────────────────────────────────
# ALLOWED_ORIGIN — the URL of your frontend app.
# Only requests from this origin are accepted (wildcard * not permitted).
ALLOWED_ORIGIN=http://localhost:5173

# PORT — Node.js server listen port (Docker only; CF Worker uses wrangler.toml [dev] port).
PORT=3001

# WEB_SEARCH_BACKEND — 'ddg' (default, no key needed) or 'brave' (needs BRAVE_API_KEY).
WEB_SEARCH_BACKEND=ddg

# ── /web/* quotas (all optional — see src/rate-limit.ts's DEFAULTS for fallbacks if unset) ────
# WEB_REQUESTS_PER_HOUR=120
# WEB_BYTES_PER_HOUR=2000000
# WEB_MAX_CONCURRENT_FETCHES=4
# WEB_HOST_REQUESTS_PER_HOUR=60
# WEB_PER_IP_REQUESTS_PER_HOUR=30
# WEB_BRAVE_DAILY_CEILING=2000
# WEB_GRANT_REQUESTS_PER_HOUR=20
# WEB_GUARD_REJECT_ALERT_THRESHOLD=5
