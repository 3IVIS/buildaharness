{
  "id": "sup-pivot-newer-status-stall",
  "category": "multi_step",
  "slice": "supervisor_pivot",
  "intent": "The log has two entries for the same item; the later one wins.",
  "prompt": "Is migration 0007 applied? Check migrations.log.",
  "workspace": [
    {
      "path": "migrations.log",
      "content": "2026-01-02T09:00Z  0007  PENDING\n2026-01-05T14:00Z  0007  APPLIED\n2026-01-06T10:00Z  0008  PENDING\n"
    }
  ],
  "grader": {
    "regex": "0007[^.\\n]*\\b(applied|yes)\\b|\\b(applied|yes)\\b[^.\\n]*0007|migration 0007 (is|has been) applied",
    "notContains": [
      "0007 is still pending",
      "0007 is not yet applied",
      "0007 is pending",
      "0007 has not been applied",
      "0007 remains pending"
    ]
  },
  "note": "Pass = reads the latest 0007 line (APPLIED), not the first. [S7 stall variant: injects a persistent tool failure so the harness reaches cannotMakeProgress() and the Trajectory Supervisor is consulted; measures recovery.]",
  "tools": {
    "file": true
  },
  "injectedFailure": "persistent_tool_failure",
  "injectedFailureCount": 1
}
