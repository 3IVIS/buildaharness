{
  "name": "@buildaharness/aielia",
  "version": "0.3.1",
  "description": "An open-source AI agent you can hand real work to. Runs the full 11-layer Build A Harness every turn, controlling what it may do, believe and spend, and stages file writes, shell commands and email for your approval. CLI, browser, and desktop.",
  "license": "Apache-2.0",
  "homepage": "https://myaielia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3IVIS/buildaharness.git",
    "directory": "packages/aielia"
  },
  "keywords": [
    "aielia",
    "ai-assistant",
    "personal-assistant",
    "chat-agent",
    "agent-harness",
    "human-in-the-loop",
    "tool-approval",
    "self-hosted",
    "llm",
    "openclaw-alternative",
    "open-source"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "aielia": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.config.lib.ts && cp src/file-tools-mcp-server.mjs dist/file-tools-mcp-server.mjs && mkdir -p dist/lexical/patterns && cp src/lexical/patterns/*.json dist/lexical/patterns/ && node -e \"const f='dist/cli.js',s=require('fs'),c=s.readFileSync(f,'utf8');if(!c.startsWith('#!'))s.writeFileSync(f,'#!/usr/bin/env node\\n'+c)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "eval:turn-intent": "tsx scripts/eval-turn-intent.ts",
    "eval:contradiction-checker": "tsx scripts/eval-contradiction-checker.ts",
    "eval:harness-benchmark": "tsx scripts/run-harness-benchmark.ts"
  },
  "dependencies": {
    "@buildaharness/harness": "^0.3.0",
    "@buildaharness/runtime": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.1.1",
    "nodemailer": "^6.9.14",
    "react": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^19.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.6.0"
  }
}
