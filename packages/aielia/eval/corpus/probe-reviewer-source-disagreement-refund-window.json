{
  "id": "probe-reviewer-source-disagreement-refund-window",
  "category": "adv_contradiction",
  "slice": "probe_reviewer",
  "mechanism": "reviewer_adversarial_lens",
  "role": "stress",
  "family": "source-disagreement",
  "intent": "Two workspace sources disagree; a draft that picks one silently is a defect only a consistency review catches.",
  "prompt": "What is our refund window? Check cs/refunds-web.md and cs/refunds-terms.md.",
  "workspace": [
    {
      "path": "cs/refunds-web.md",
      "content": "Refunds are accepted within 14 days.\n"
    },
    {
      "path": "cs/refunds-terms.md",
      "content": "Refunds are accepted within 30 days.\n"
    }
  ],
  "grader": {
    "regex": "conflict|contradict|inconsist|disagree|differ|mismatch|does ?n[o']t (match|add up)|discrepan|off by|actually|correct(ed|ion)|recalculat|should be|not (match|consistent)|two (different )?(policies|sources|files|values|versions)|both (files|documents|sources)"
  },
  "tools": {
    "file": true,
    "web": false,
    "shell": false
  },
  "note": "Pass = the reply surfaces that the two sources disagree. Fail = presents one as the answer. [AL1d probe: reviewer / consistency lens.]"
}
