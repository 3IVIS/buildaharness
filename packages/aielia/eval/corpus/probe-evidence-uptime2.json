{
  "id": "probe-evidence-uptime2",
  "category": "research",
  "slice": "probe_evidence",
  "mechanism": "verification_evidence_sufficiency",
  "role": "calm-control",
  "family": "ample-agreeing-evidence",
  "intent": "Control \u2014 two independent sources agree; evidence sufficiency must not hedge.",
  "prompt": "What was last quarter's uptime? See https://s1.example.test/up and https://s2.example.test/up.",
  "webPages": [
    {
      "url": "https://s1.example.test/up",
      "content": "<html><head><title>Source 1</title></head><body>Uptime last quarter: 99.95 percent.</body></html>"
    },
    {
      "url": "https://s2.example.test/up",
      "content": "<html><head><title>Source 2</title></head><body>Quarterly uptime came to 99.95 percent.</body></html>"
    }
  ],
  "grader": {
    "contains": [
      "99.95"
    ],
    "notContains": [
      "cannot verify",
      "unverified",
      "conflict",
      "not sure",
      "may be wrong"
    ]
  },
  "tools": {
    "file": false,
    "web": true,
    "shell": false
  },
  "note": "Pass = states 99.95 plainly. Fail = a spurious hedge or 'unverified' caveat despite two agreeing sources. [AL1e probe: verification_evidence_sufficiency / calm control.]"
}
