{
  "id": "probe-evidence-opened",
  "category": "research",
  "slice": "probe_evidence",
  "mechanism": "verification_evidence_sufficiency",
  "role": "calm-control",
  "family": "ample-agreeing-evidence",
  "intent": "Control \u2014 two independent sources agree; evidence sufficiency must not hedge.",
  "prompt": "When did the office open per https://s7.example.test/o and https://s8.example.test/o?",
  "webPages": [
    {
      "url": "https://s7.example.test/o",
      "content": "<html><head><title>Source 1</title></head><body>The office opened in 2015.</body></html>"
    },
    {
      "url": "https://s8.example.test/o",
      "content": "<html><head><title>Source 2</title></head><body>Opening year of the office: 2015.</body></html>"
    }
  ],
  "grader": {
    "contains": [
      "2015"
    ],
    "notContains": [
      "cannot verify",
      "unverified",
      "conflict",
      "not sure",
      "may be wrong"
    ]
  },
  "tools": {
    "file": false,
    "web": true,
    "shell": false
  },
  "note": "Pass = states 2015 plainly. Fail = a spurious hedge or 'unverified' caveat despite two agreeing sources. [AL1e probe: verification_evidence_sufficiency / calm control.]"
}
